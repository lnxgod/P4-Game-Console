.DS_Store

# ESP-IDF build products. Keep dependency lockfiles committed.
build/
build-*/
apps/*/build/
apps/*/sdkconfig
apps/*/sdkconfig.old
managed_components/
.tools/

# Local IDE and Python state.
.idea/
.vscode/
__pycache__/
*.pyc
/tmp/
/result.json

# Local source/reference archives used only by provenance verifiers.
*.zip
local-data/lord-upstream/

# Doom game data is supplied locally and never committed or embedded.
*.[Ww][Aa][Dd]

# Quake game data is supplied locally/on SD and never committed or embedded.
*.[Pp][Aa][Kk]

# Device-specific recovery images are kept locally, never in Git.
hardware/backups/*.bin
test-runs/doom-e6-rollback-*/

# Per-device one-shot authorization ledgers and launch receipts are local only.
hardware/local-state/
local-data/quake/id1/pak0.pak
local-data/quake/id1/config.cfg
hardware/backups/.waveshare-readback.*
