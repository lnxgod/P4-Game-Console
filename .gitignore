.DS_Store

# ESP-IDF build products. Keep dependency lockfiles committed.
build/
build-*/
apps/*/build/
apps/*/sdkconfig
apps/*/sdkconfig.old
managed_components/
.tools/

# Stray compiler, linker, CMake, and Ninja products outside build directories.
*.o
*.obj
*.a
*.lib
*.so
*.dylib
*.dll
*.exe
*.elf
*.hex
*.map
*.uf2
*.bin
*.img
*.iso
*.dmg
*.[Pp]4[Gg]
*.[Pp]4[Rr]
*.[Pp]4[Uu]
*.[Pp]4[Cc][Aa][Rr][Tt]
*.d
*.dSYM/
*.gcda
*.gcno
*.profraw
CMakeCache.txt
CMakeFiles/
CTestTestfile.cmake
Testing/
build.ninja
rules.ninja
.ninja_deps
.ninja_log
compile_commands.json

# This generated binary is a checked-in runtime game asset, not firmware.
!games/byte_buddy/assets/generated/byte_buddy_dragon_art.bin

# Local IDE and Python state.
.idea/
.vscode/
__pycache__/
*.pyc
.pytest_cache/
.coverage
coverage/
/tmp/
/result.json
/.codex-worktrees/
/.playwright-mcp/
/agent-*.png
/grokcoder-*.png

# Wacky Wheels diagnostic frame dumps are local test output.
/wacky-client.rgb565
/wacky-host.rgb565
/wacky-menu.rgb565

# Reproducible design exports and downloaded research stay local. The curated
# PNG/HTML galleries, original sources, licenses and provenance remain tracked.
/design/tab5-nextgen/native/*.ppm
/design/tab5-nextgen/native/review-[0-4].png
/design/tab5-nextgen/native/settings.png
/design/tab5-nextgen/boot-flight/entrance.png
/design/tab5-nextgen/boot-flight/settled.png
/design/tab5-nextgen/research/Tab5_Schematics_PDF.pdf
/design/tab5-nextgen/research/power-schematic.png

# Local logs, editor swaps, and interrupted-patch residue.
*.log
*.tmp
*.bak
*.orig
*.rej
*~
*.swp
*.swo

# Finder/iCloud conflict copies are stale local duplicates, never source.
* 2.*

# Local source/reference archives used only by provenance verifiers.
*.zip
local-data/lord-upstream/
local-data/realm/

# Doom game data is supplied locally and never committed or embedded.
*.[Ww][Aa][Dd]
local-data/doom/chex.deh
local-data/doom/freedoom-0.13.0-release/

# Quake game data is supplied locally/on SD and never committed or embedded.
*.[Pp][Aa][Kk]

# Device-specific recovery data stays local. The tracked manifest records only
# provenance and checksums; the required runtime .bin asset is exempted above.
hardware/backups/*
!hardware/backups/manifest.json
test-runs/doom-e6-rollback-*/

# Raw UART transcripts can contain host and physical-device identifiers. Keep
# them local, except for the historical upstream fixture used by Doom tests.
hardware/test-runs/*.raw
!hardware/test-runs/2026-08-13-doom-e5-touch-only-runtime.raw

# Per-device one-shot authorization ledgers and launch receipts are local only.
hardware/local-state/
local-data/quake/id1/pak0.pak
local-data/quake/id1/config.cfg
hardware/backups/.waveshare-readback.*
