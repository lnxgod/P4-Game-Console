{
  "schema": 1,
  "recorded_utc": "2026-10-06T05:22:45.341091+00:00",
  "request": "Remove the old Lua game-creation stack; retain native Maze Chase, Byte Buddy and Red Dragon.",
  "status": "source-removed-host-and-tab5-build-tested",
  "changes": [
    "Physically removed game-platform Lua engine, old APIs, examples, packers, QR tools and generated caches.",
    "Removed Lua vendor source/scripts, script renderer/audio, Lua-only content parser, and retired skill including its archive.",
    "Preserved the native cartridge entry byte-for-byte under p4_game_api/runtime and extracted clock scheduling into p4_frame_scheduler.",
    "Retained native USB/WAD transfer bounds and test SHA-256 independently of the removed parser.",
    "Removed host pack/inspect implementations. Compatibility commands only reject old formats without mutation.",
    "Updated active skills/docs and added guards against retired components, symbols and source trees."
  ],
