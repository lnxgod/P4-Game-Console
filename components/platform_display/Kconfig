menu "P4 platform display service"

    config PLATFORM_DISPLAY_ELECROW_10_1_CROSS_REVISION_AUTHORIZED
        bool "Authorize the reviewed Elecrow 10.1-inch display-only path"
        default n
        help
            Allows this component to operate only the MIPI-DSI bus, internal
            LDO3/LDO4, and GPIO31 backlight path documented in
            hardware/evidence/elecrow-10.1-display-path.json. This option does
            not authorize GPIO29, GPIO41, touch, storage, audio, camera,
            wireless, USB, or any other GPIO.

    config PLATFORM_DISPLAY_WAVESHARE_4_3_BUILD_ONLY
        bool "Compile the Waveshare 4.3-inch ST7701 display client"
        default n
        help
            Enables the board-specific 480x800 portrait ST7701 seam. This is
            a build-only gate and does not prove LCD FPC identity, timing, or
            panel output.

endmenu
