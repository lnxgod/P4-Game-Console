menu "P4 platform storage service"

    config PLATFORM_STORAGE_ELECROW_10_1_CROSS_REVISION_AUTHORIZED
        bool "Authorize the reviewed Elecrow 10.1-inch SDMMC path"
        default n
        help
            Allows this component to operate only SDMMC slot 0 in one-bit
            mode on GPIO43 (CLK), GPIO44 (CMD), and GPIO39 (D0), as
            documented in hardware/evidence/elecrow-10.1-storage-path.json.
            Mounting never formats the card. This option does not authorize
            D1-D7, card-detect, write-protect, display, touch, audio, camera,
            wireless, USB, or any other GPIO.

    config PLATFORM_STORAGE_WAVESHARE_4_3_AUTHORIZED
        bool "Authorize the Waveshare 4.3 SDMMC path"
        depends on PLATFORM_BOARD_TARGET_WAVESHARE_4_3
        default n
        help
            Allows this component to mount the Waveshare 4.3 microSD socket
            without formatting, using only SDMMC0 one-bit SDR on the
            documented GPIO43 (CLK), GPIO44 (CMD), and GPIO39 (D0) subset.
            D1-D3, card detect, write protect, and unrelated peripherals stay
            disabled. Enable only in the board-specific Console OS profile.

endmenu
