# SPDX-License-Identifier: GPL-2.0-or-later

CONFIG_IDF_TARGET="esp32p4"
CONFIG_APP_REPRODUCIBLE_BUILD=y
CONFIG_APP_COMPILE_TIME_DATE=n

CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_ESP32P4_REV_MIN_100=y

CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_AFTER_NORESET=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_360=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ=360

CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_HEX=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=1024
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=65536

CONFIG_ESP_MAIN_TASK_STACK_SIZE=24576
CONFIG_VFS_SUPPORT_DIR=y
CONFIG_FATFS_LFN_HEAP=y
# USB mass storage and the wear-levelling block device both expose 512-byte
# logical sectors.  Generate and mount FAT with the same geometry.
CONFIG_FATFS_SECTOR_512=y
CONFIG_WL_SECTOR_SIZE_512=y
CONFIG_WL_SECTOR_MODE_PERF=y

# J16 is the ESP32-P4 HS device port. The shared FAT volume is automatically
# handed between the app and the USB host; both sides are never mounted at once.
CONFIG_TINYUSB_MSC_ENABLED=y
CONFIG_TINYUSB_MSC_BUFSIZE=8192
CONFIG_TINYUSB_DESC_MANUFACTURER_STRING="P4 Console"
CONFIG_TINYUSB_DESC_PRODUCT_STRING="P4 Game Storage"
CONFIG_TINYUSB_DESC_SERIAL_STRING="P4-GAMES-V1"
CONFIG_TINYUSB_DESC_MSC_STRING="Game Storage"

CONFIG_ESP_TASK_WDT_PANIC=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=20
CONFIG_IDF_EXPERIMENTAL_FEATURES=y

# These select the already-reviewed display, touch, and build-only factory
# audio source paths. They are not flash or hardware-execution authorization.
CONFIG_PLATFORM_DISPLAY_ELECROW_10_1_CROSS_REVISION_AUTHORIZED=y
CONFIG_PLATFORM_TOUCH_ELECROW_10_1_CROSS_REVISION_AUTHORIZED=y
CONFIG_PLATFORM_AUDIO_FACTORY_ELECROW_10_1_BUILD_ONLY=y
CONFIG_DOOM_AUDIO_ENGINE_ADAPTER=y
CONFIG_ESP_LCD_TOUCH_MAX_POINTS=5
CONFIG_ESP_LCD_TOUCH_MAX_BUTTONS=0
