CONFIG_IDF_TARGET="esp32p4"

CONFIG_APP_REPRODUCIBLE_BUILD=y
CONFIG_APP_COMPILE_TIME_DATE=n

# The connected P4 is revision v1.3; pre-v3 and v3+ images are incompatible.
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_ESP32P4_REV_MIN_100=y

CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_HEX=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_SPIRAM_USE_CAPS_ALLOC=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# Build the complete transport, but make the image electrically inert. This
# remains disabled until a committed reviewed fixture record and exact physical
# PCB USB-path evidence are bound by the verifier.
CONFIG_PLATFORM_USB_HOST_FIXTURE_AUTHORIZED=n
