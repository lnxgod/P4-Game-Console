# SPDX-License-Identifier: GPL-2.0-or-later

CONFIG_IDF_TARGET="esp32p4"
CONFIG_APP_REPRODUCIBLE_BUILD=y
CONFIG_APP_COMPILE_TIME_DATE=n

CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_ESP32P4_REV_MIN_100=y

CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
# Keep the CPU in the ROM loader until a future E2 verifier has checked the
# exact app readback. This build-only app is not yet in the flash allowlist.
CONFIG_ESPTOOLPY_AFTER_NORESET=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_360=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ=360

CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_HEX=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_SPIRAM_USE_MALLOC=y
# Doom precaches roughly 533 KiB of SFX in many allocations. Keep all but
# genuinely small allocations eligible for PSRAM instead of consuming the
# scarce internal heap as E1's video-only 16 KiB threshold would.
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=1024
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=65536

CONFIG_ESP_MAIN_TASK_STACK_SIZE=24576
CONFIG_VFS_SUPPORT_DIR=y

# The pinned DSI setup contains hardware waits. Preserve fail-reset behavior.
CONFIG_ESP_TASK_WDT_PANIC=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=20
CONFIG_IDF_EXPERIMENTAL_FEATURES=y

CONFIG_PLATFORM_DISPLAY_ELECROW_10_1_CROSS_REVISION_AUTHORIZED=y
CONFIG_PLATFORM_AUDIO_ELECROW_10_1_REVIEWED_BUILD_ONLY=y
CONFIG_DOOM_AUDIO_ENGINE_ADAPTER=y
