menu "Doom audio integration"
    config DOOM_AUDIO_ENGINE_ADAPTER
        bool "Build the project Doom sound-effect adapter"
        default n
        help
            Builds the FEATURE_SOUND adapter, fixed 16 kHz stereo mixer, and
            platform_audio worker. This is a compile-time integration seam,
            not permission to flash or energize the speaker path.
endmenu
