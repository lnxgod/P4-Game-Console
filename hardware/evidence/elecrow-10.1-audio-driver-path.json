      "mute_readback": "REG31 mask 0x60 must equal 0x60 while muted and 0x00 while unmuted",
      "volume_readback": "REG32 must equal 0x60 for the exact five-percent diagnostic volume",
      "clock_and_format_readback": "Immediately before amplifier enable, REG01..REG09 must match the reviewed 16 kHz, 4.096 MHz MCLK, slave Philips-I2S PCM16 configuration using masks for documented preserved bits",
      "failure_action": "drive GPIO30 high immediately on setter failure, read failure, or register mismatch"
    },
    "startup_order": [
      "drive GPIO30 high before logging, power, bus, or clock creation",
      "acquire internal LDO3 at 2500 mV, then LDO4 at 3300 mV, and wait 20 ms",
      "create I2C0 and require an explicit acknowledgement at 7-bit address 0x18",
      "start I2S1 with GPIO24 MCLK while amplifier remains shut down",
      "initialize ES8311 at 7-bit address 0x18",
      "open codec, set mute, cap volume at 10 percent, and read back REG31 and REG32",
      "submit zero preroll and re-read the reviewed clock, format, mute, and volume registers immediately before amplifier enable",
      "drive GPIO30 low, wait 20 ms while muted, then unmute"
    ],
    "shutdown_order": [
      "mute ES8311 DAC and verify REG31 mute bits by readback",
      "wait 10 ms",
      "drive GPIO30 high",
      "close codec and clocks",
      "delete I2C0",
      "drive GPIO30 high again, then release LDO4 followed by LDO3"
    ],
    "tone_limit": {
