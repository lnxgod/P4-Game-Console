# SPDX-License-Identifier: MIT

# Controller-first H2 role used for the bounded powered-hub/controller test.
# TinyUSB MSC is linked for the explicit USB Drive app, but Host/HID and MSC
# are never installed at the same time. Firmware never sources H2 VBUS.
CONFIG_P4_WAVESHARE_H2_USB_HOST_MODE=y
CONFIG_P4_WAVESHARE_H2_FORCE_FULL_SPEED_HOST=n
CONFIG_P4_WAVESHARE_H2_RUNTIME_ROLE_SWITCH=y
CONFIG_USB_HOST_HUBS_SUPPORTED=y
CONFIG_USB_HOST_HUB_MULTI_LEVEL=n
# Some already-powered low-speed HID receivers need more recovery time after
# the hub releases downstream reset. Two retries are serialized behind the
# hub's existing EP0/status chain and protected by a durable one-boot guard.
CONFIG_USB_HOST_EXT_PORT_RESET_RECOVERY_DELAY_MS=500
CONFIG_P4_USB_HOST_EXT_PORT_ENUM_RETRY_ATTEMPTS=2
CONFIG_TINYUSB_MSC_ENABLED=y
CONFIG_TINYUSB_DEBUG_LEVEL=0

# Keep the same boot-safe 32 KiB DMA/internal reserve as the base Waveshare
# image. ESP-Hosted worker stacks and the BLE datagram queue live in PSRAM, so
# this pool remains available to display, SDIO, SD card, and USB host DMA.
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768
