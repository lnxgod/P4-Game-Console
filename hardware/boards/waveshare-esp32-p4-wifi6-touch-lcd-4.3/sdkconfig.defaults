# SPDX-License-Identifier: MIT

CONFIG_P4_BOARD_ELECROW_CROWPANEL_ADVANCED_10=n
CONFIG_P4_BOARD_OLIMEX_ESP32_P4_PC_REV_B=n
CONFIG_P4_BOARD_WAVESHARE_ESP32_P4_WIFI6_TOUCH_LCD_4_3=y

CONFIG_PLATFORM_DISPLAY_WAVESHARE_4_3_BUILD_ONLY=y
CONFIG_PLATFORM_TOUCH_WAVESHARE_4_3_BUILD_ONLY=y
CONFIG_PLATFORM_AUDIO_ES8311_WAVESHARE_4_3_BUILD_ONLY=y
CONFIG_DOOM_AUDIO_ENGINE_ADAPTER=y
CONFIG_ESP_LCD_TOUCH_MAX_POINTS=5
CONFIG_ESP_LCD_TOUCH_MAX_BUTTONS=0

# Direct multiplayer is a separate 3.3 V UART crossover on J3. The exact
# board profile maps UART1 TX GPIO28/J3-16, RX GPIO29/J3-18, and common ground
# J3-24. H1 UART0 remains the automatic host-relay and content-upload fallback.
CONFIG_P4_MP_DIRECT_UART=y
CONFIG_P4_MP_DIRECT_UART_NUM=1
CONFIG_P4_MP_DIRECT_UART_TX_GPIO=28
CONFIG_P4_MP_DIRECT_UART_RX_GPIO=29
CONFIG_P4_MP_DIRECT_UART_BAUDRATE=115200
CONFIG_P4_MP_DIRECT_FALLBACK_DISCOVERIES=3

CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions-olimex.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions-olimex.csv"

CONFIG_ESPTOOLPY_FLASHSIZE_32MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="32MB"
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_HEX=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
# Leave enough internal RAM for startup while retaining a DMA-capable reserve
# for the Waveshare display, SD storage, and ESP-Hosted Wi-Fi transport.
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768

# The official schematic connects the ESP32-C6-MINI-1 using the same
# ESP32-P4 SDIO/reset map as Espressif's P4 Function-EV reference. Keep this
# exact board-only transport explicit instead of relying on component defaults.
CONFIG_SLAVE_IDF_TARGET_ESP32C6=y
CONFIG_ESP_WIFI_REMOTE_LIBRARY_HOSTED=y
CONFIG_ESP_HOSTED_SDIO_HOST_INTERFACE=y
CONFIG_ESP_HOSTED_SDIO_RESET_ACTIVE_HIGH=y
CONFIG_ESP_HOSTED_SDIO_GPIO_RESET_SLAVE=54
CONFIG_ESP_HOSTED_SDIO_4_BIT_BUS=y
CONFIG_ESP_HOSTED_SDIO_PIN_CLK=18
CONFIG_ESP_HOSTED_SDIO_PIN_CMD=19
CONFIG_ESP_HOSTED_SDIO_PIN_D0=14
CONFIG_ESP_HOSTED_SDIO_PIN_D1=15
CONFIG_ESP_HOSTED_SDIO_PIN_D2=16
CONFIG_ESP_HOSTED_SDIO_PIN_D3=17
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=n

# H2 is the ESP32-P4 native sink/device connector. Export the microSD card as
# one MSC LUN; platform_game_storage enforces exclusive app-or-host ownership
# and keeps runtime formatting disabled.
CONFIG_TINYUSB_MSC_ENABLED=y
CONFIG_TINYUSB_MSC_BUFSIZE=4096
CONFIG_TINYUSB_DESC_BCD_DEVICE=0x0402
CONFIG_TINYUSB_DESC_MANUFACTURER_STRING="Game Changers AI"
CONFIG_TINYUSB_DESC_PRODUCT_STRING="P4 Game Storage"
CONFIG_TINYUSB_DESC_MSC_STRING="P4 Game Storage"

# The codec uses the pinned ESP-IDF I2C master API on the touch-owned bus.
# CONFIG_CODEC_I2C_BACKWARD_COMPATIBLE is not set
