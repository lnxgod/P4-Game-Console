# SPDX-License-Identifier: MIT
# M5Stack Tab5 C145/K145. Build candidate; exact-unit flash gate remains closed.
CONFIG_P4_BOARD_ELECROW_CROWPANEL_ADVANCED_10=n
CONFIG_P4_BOARD_OLIMEX_ESP32_P4_PC_REV_B=n
CONFIG_P4_BOARD_WAVESHARE_ESP32_P4_WIFI6_TOUCH_LCD_4_3=n
CONFIG_P4_BOARD_M5STACK_TAB5=y
CONFIG_P4_TAB5_USB_HOST=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions-tab5.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions-tab5.csv"
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_HEX=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=65536
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_UART_DEFAULT=n
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
CONFIG_ESP_CONSOLE_SECONDARY_USB_SERIAL_JTAG=n
CONFIG_P4_MP_DIRECT_UART=n
# Bound queued UDP datagrams while absorbing a burst between runtime polls.
CONFIG_LWIP_UDP_RECVMBOX_SIZE=32
CONFIG_DOOM_AUDIO_ENGINE_ADAPTER=y
CONFIG_ESP_LCD_TOUCH_MAX_POINTS=5
CONFIG_ESP_LCD_TOUCH_MAX_BUTTONS=0
CONFIG_CODEC_I2C_BACKWARD_COMPATIBLE=n
CONFIG_CODEC_ES8388_SUPPORT=y
CONFIG_FATFS_FS_LOCK=8
# Avoid repeated FAT-chain walks for Arena's random texture and sprite reads.
# 2 + 2*ceil(28787748/512) words covers the largest pinned Arena WAD even
# with one fragment per minimum-size cluster: 449824 bytes per read-only file.
# The storage service's eight handles cap these PSRAM maps at 3598592 bytes.
CONFIG_FATFS_USE_FASTSEEK=y
CONFIG_FATFS_ALLOC_PREFER_EXTRAM=y
CONFIG_FATFS_FAST_SEEK_BUFFER_SIZE=112456

# Explicitly authorized battery charger repair, 2026-10-05.
CONFIG_P4_TAB5_CHARGER_500MA=y

# Keep independent touch/refresh interrupts serviceable during large PSRAM
# writebacks. Buffers stay exclusively owned throughout each complete sync.
CONFIG_ESP_MM_CACHE_MSYNC_C2M_CHUNKED_OPS=y
CONFIG_ESP_MM_CACHE_MSYNC_C2M_CHUNKED_OPS_MAX_LEN=0x8000
