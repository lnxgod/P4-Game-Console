    "radio": {
      "chip": "ESP32-C6",
      "sdio_slot": 1,
      "clk": 12,
      "cmd": 13,
      "data": [
        11,
        10,
        9,
        8
      ],
      "reset": 15,
      "power_enable": "expander 0x44 P0"
    },
    "usb": {
      "type_c": "native FS USB Serial/JTAG GPIO24/25",
      "type_a": "native HS USB host dedicated PHY; power expander 0x44 P3",
      "host_power_enabled_by_initial_port": false
    }
  },
  "inputs": [
    "touch"
  ],
  "touch": true,
  "laptop_content_transfer": "powered-off-removable-media"
